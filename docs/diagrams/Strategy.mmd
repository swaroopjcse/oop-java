classDiagram

    class FareStrategy <<interface>>{
        + computeFare() double
    }

    class FareCalculationContext {
        - FareStrategy currentStrategy
        + setStrategy() void
        + executeCalculation() double
    }

    FareCalculationContext --o FareStrategy

    GeneralFareStrategy ..|> FareStrategy

    TatkalFareStrategy ..|> FareStrategy

    SeniorsFareStrategy ..|> FareStrategy
